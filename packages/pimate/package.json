{
  "name": "@phni3j9a/pimate",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ]
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "build": "esbuild src/extension/index.ts --bundle --packages=external --platform=node --format=esm --outfile=dist/extension.js",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "diff": "8.0.4",
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.28.2",
    "@types/node": "^22.18.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4",
    "typebox": "1.3.27",
    "@earendil-works/pi-tui": "1.3.0"
  },
  "license": "MIT"
}
